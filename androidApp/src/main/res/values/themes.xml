<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style
        name="Theme.PriceIntelligence"
        parent="android:style/Theme.Material.NoActionBar">

        <item name="android:windowBackground">#0B0F14</item>
        <item name="android:colorAccent">#22C55E</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style
        name="Theme.PriceIntelligence.Starting"
        parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">#0B0F14</item>

        <item name="windowSplashScreenAnimatedIcon">
            @drawable/ic_splash_logo
        </item>

        <item name="windowSplashScreenIconBackgroundColor">
            #0B0F14
        </item>

        <item
            name="android:windowSplashScreenBrandingImage"
            tools:targetApi="31">
            @drawable/splash_branding
        </item>

        <item name="postSplashScreenTheme">
            @style/Theme.PriceIntelligence
        </item>
    </style>

</resources>