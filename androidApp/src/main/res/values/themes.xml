<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PriceIntelligence" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#08111F</item>
        <item name="android:colorAccent">#22C55E</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.PriceIntelligence.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#08111F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">#08111F</item>
        <item name="postSplashScreenTheme">@style/Theme.PriceIntelligence</item>
    </style>
</resources>
