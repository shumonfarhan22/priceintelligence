{
  "expo": {
    "name": "Price Intelligence V2",
    "slug": "price-intelligence-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app_icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0F14",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7cb4b6e5-4a5f-4a0e-9f37-priceintel"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.supreme.priceintelligence.priceintelligence.v2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.supreme.priceintelligence.v2",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14",
        "foregroundImage": "./assets/brand/app_icon.png",
        "monochromeImage": "./assets/brand/app_icon.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/brand/app_icon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash_branding.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0F14"
        }
      ],
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Price Intelligence to scan product barcodes.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "511d6288-5cca-4d9b-81d6-bd3669577a45"
      }
    }
  }
}
